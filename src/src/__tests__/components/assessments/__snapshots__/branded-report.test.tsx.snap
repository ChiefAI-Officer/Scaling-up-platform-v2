exports[`BrandedReport — cover keeps the representative Scaling Up Full Classic DOM unchanged when styles are unavailable 1`] = `"<link rel="preload" as="image" href="/brand/su-logo-white.svg"/><div class="su-public-brand su-report" data-testid="branded-report"><section class="su-report-cover" data-testid="report-cover"><div class="su-stripe-h"></div><div class="su-report-cover-inner"><div class="su-brandbar"><img class="su-logo" src="/brand/su-logo-white.svg" alt="Scaling Up" width="180" height="24"/></div><h1 class="su-h1 su-report-title">Scaling Up Full</h1><div class="su-report-cover-meta"><div class="su-report-for">Report for: Sarah Chen · Chief Executive Officer</div><div class="su-report-email">Email: sarah@example.com</div><div class="su-report-sub">Northwind Logistics · June 5, 2026</div></div></div></section><section class="su-report-overall" data-testid="report-overall"><div class="su-report-eyebrow">Overall result</div><span class="sr-only">Overall score: 72 / 100, Scaling</span><div class="su-report-overall-main"><div class="su-report-ringwrap" aria-hidden="true"><div class="su-report-headline su-report-headline-num">72</div><div class="su-report-headline-den">/ 100</div></div><div class="su-report-overall-text"><div class="su-report-band" data-testid="overall-band">Scaling</div><p class="su-report-lede">Solid foundation.</p></div></div><div class="su-report-stats"><div class="su-report-stat"><span class="su-report-stat-v">12</span><span class="su-report-stat-l">Total points</span></div><div class="su-report-stat"><span class="su-report-stat-v">6</span><span class="su-report-stat-l">Average per item</span></div><div class="su-report-stat"><span class="su-report-stat-v">2</span><span class="su-report-stat-l">Sections</span></div></div></section><section class="su-report-decisions" data-testid="report-decisions"><div class="su-report-eyebrow">How you scored, by decision</div><h2 class="su-h2 su-report-sec-title">Your Four Decisions</h2><div class="su-report-card-grid"><div class="su-report-decision-card" data-testid="decision-card-people" style="border-left-color:#f7a600"><div class="su-report-decision-head"><span class="su-report-decision-name">People</span><span class="su-report-decision-avg" style="color:#946b36">7</span></div><div class="su-report-decision-bar"><i style="width:70%;background-color:#f7a600"></i></div><div class="su-report-decision-sub">7 points</div></div><div class="su-report-decision-card" data-testid="decision-card-you" style="border-left-color:#522583"><div class="su-report-decision-head"><span class="su-report-decision-name">You</span><span class="su-report-decision-avg" style="color:#522583">5</span></div><div class="su-report-decision-bar"><i style="width:50%;background-color:#522583"></i></div><div class="su-report-decision-sub">5 points</div></div></div></section><section class="su-report-sections" data-testid="report-sections"><div class="su-report-eyebrow">Detailed breakdown</div><h2 class="su-h2 su-report-sec-title">How you scored, section by section</h2><div class="su-report-grid"><div class="su-report-card"><div class="su-report-card-head" data-testid="section-head-s_people" style="background-color:#f7a600"><span data-testid="domain-colored-head" aria-hidden="true" style="display:none"></span><h3 class="su-report-card-title">Team Health</h3></div><ul class="su-report-card-list"><li class="su-report-q"><span class="su-report-q-label">Weekly strategic thinking meeting</span><span class="su-report-q-rate">7</span></li></ul></div><div class="su-report-card"><div class="su-report-card-head" data-testid="section-head-s_you" style="background-color:#522583"><span data-testid="domain-colored-head" aria-hidden="true" style="display:none"></span><h3 class="su-report-card-title">Personal Leadership</h3></div><ul class="su-report-card-list"><li class="su-report-q"><span class="su-report-q-label">I make time for personal renewal</span><span class="su-report-q-rate">5</span></li></ul></div></div>