// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`ED10 golden — INVITED SectionPager (pre-previewMode) opening render of a representative multi-section INVITED survey 1`] = `"<div class="su-assessment-brand survey-section"><header class="su-shell-header" role="banner"><img class="su-shell-logo" alt="Scaling Up" src="/brand/su-logo-white.svg"><span class="su-shell-where" aria-live="polite"><span class="su-shell-assessment">Rockefeller Habits</span><span class="su-shell-where-sep" aria-hidden="true"> · </span><b class="su-shell-company">Northwind Logistics</b><span class="su-shell-section"> — Section 1 of 2</span></span><div role="progressbar" aria-label="Progress" aria-valuemin="0" aria-valuemax="2" aria-valuenow="0" class="survey-progress su-shell-progress"><div class="survey-progress-fill" style="width: 0%;"></div></div></header><section class="su-section-intro" style="--su-section-accent: #008bd2;"><div class="su-intro-rail" aria-hidden="true"></div><span class="su-intro-label">Decision 1</span><h2 tabindex="-1" class="survey-section-title">Strategy</h2><div class="su-intro-covers"><span class="su-intro-covers-k">What this section covers</span><p class="su-intro-desc">How you set direction and priorities.</p></div></section><ul class="survey-question-list"><li class="survey-question"><label for="q-S1_q1" class="survey-question-label">How confident are you in your strategy?<span class="survey-required" aria-hidden="true"> *</span></label><div class="survey-slider-wrap is-unanswered"><input id="q-S1_q1" class="survey-slider" min="0" max="10" step="1" aria-valuemin="0" aria-valuemax="10" aria-valuetext="Not yet answered" type="range" value="0"><div class="survey-slider-ticks"><button type="button" class="survey-slider-tick" tabindex="-1" aria-label="Set rating to 0">0</button><button type="button" class="survey-slider-tick" tabindex="-1" aria-label="Set rating to 1">1</button><button type="button" class="survey-slider-tick" tabindex="-1" aria-label="Set rating to 2">2</button><button type="button" class="survey-slider-tick" tabindex="-1" aria-label="Set rating to 3">3</button><button type="button" class="survey-slider-tick" tabindex="-1" aria-label="Set rating to 4">4</button><button type="button" class="survey-slider-tick" tabindex="-1" aria-label="Set rating to 5">5</button><button type="button" class="survey-slider-tick" tabindex="-1" aria-label="Set rating to 6">6</button><button type="button" class="survey-slider-tick" tabindex="-1" aria-label="Set rating to 7">7</button><button type="button" class="survey-slider-tick" tabindex="-1" aria-label="Set rating to 8">8</button><button type="button" class="survey-slider-tick" tabindex="-1" aria-label="Set rating to 9">9</button><button type="button" class="survey-slider-tick" tabindex="-1" aria-label="Set rating to 10">10</button></div><div class="survey-slider-anchors"><span>Not at all</span><span>Completely</span></div><p class="survey-slider-status">Tap a number or drag the slider to rate.</p></div></li></ul><div class="survey-nav"><button type="button" class="wf-btn wf-btn-secondary">Back</button><button type="button" class="wf-btn wf-btn-primary">Next</button></div></div>"`;

exports[`ED10 golden — eligible Settings default report appearance adds only the approved report-default card to the current Settings tab 1`] = `
"<div class="space-y-6"><header class="wf-page-header-row"><div class="wf-page-title-block"><div class="wf-page-pill-row"><span data-testid="template-editor-version-pill" class="wf-version-pill-draft">v2 (draft)</span><span class="wf-pill wf-pill-access-invited">Invited</span><span class="wf-pill wf-pill-agg-full">Everyone</span><span style="font-style: italic;">(you are here)</span></div></div><div class="wf-page-action-row"><div class="relative"><button type="button" data-testid="safe-to-publish-badge" data-tone="blocker" class="wf-btn wf-btn-secondary wf-btn-sm">4 blockers</button></div><button type="button" class="wf-btn wf-btn-secondary wf-btn-sm" data-testid="template-editor-test-mode-btn">Test Mode</button><button type="button" disabled="" class="wf-btn wf-btn-secondary wf-btn-sm" data-testid="template-editor-save-draft-btn">Save Draft</button><button type="button" data-testid="template-editor-publish-btn" class="wf-btn wf-btn-primary wf-btn-sm">Publish v2 →</button></div></header><div dir="ltr" data-orientation="horizontal" aria-label="Template editor tabs"><div role="tablist" aria-orientation="horizontal" class="flex items-center gap-5 border-b border-border overflow-x-auto mb-6" tabindex="0" data-orientation="horizontal" style="outline: none;"><button type="button" role="tab" aria-selected="false" aria-controls="radix-_rID_-content-preview" data-state="inactive" id="radix-_rID_-trigger-preview" class="inline-flex items-center gap-1.5 whitespace-nowrap px-0.5 py-2.5 text-sm font-medium text-muted-foreground border-b-2 border-transparent transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 data-[state=active]:text-primary data-[state=active]:font-semibold data-[state=active]:border-primary disabled:opacity-50 disabled:cursor-not-allowed data-[disabled]:opacity-50 data-[disabled]:cursor-not-allowed" tabindex="-1" data-orientation="horizontal" data-radix-collection-item="">Preview</button><button type="button" role="tab" aria-selected="false" aria-controls="radix-_rID_-content-questions" data-state="inactive" id="radix-_rID_-trigger-questions" class="inline-flex items-center gap-1.5 whitespace-nowrap px-0.5 py-2.5 text-sm font-medium text-muted-foreground border-b-2 border-transparent transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 data-[state=active]:text-primary data-[state=active]:font-semibold data-[state=active]:border-primary disabled:opacity-50 disabled:cursor-not-allowed data-[disabled]:opacity-50 data-[disabled]:cursor-not-allowed" tabindex="-1" data-orientation="horizontal" data-radix-collection-item="">Build</button><button type="button" role="tab" aria-selected="false" aria-controls="radix-_rID_-content-scoring" data-state="inactive" id="radix-_rID_-trigger-scoring" class="inline-flex items-center gap-1.5 whitespace-nowrap px-0.5 py-2.5 text-sm font-medium text-muted-foreground border-b-2 border-transparent transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 data-[state=active]:text-primary data-[state=active]:font-semibold data-[state=active]:border-primary disabled:opacity-50 disabled:cursor-not-allowed data-[disabled]:opacity-50 data-[disabled]:cursor-not-allowed" tabindex="-1" data-orientation="horizontal" data-radix-collection-item="">Scoring &amp; Tiers</button><button type="button" role="tab" aria-selected="true" aria-controls="radix-_rID_-content-settings" data-state="active" id="radix-_rID_-trigger-settings" class="inline-flex items-center gap-1.5 whitespace-nowrap px-0.5 py-2.5 text-sm font-medium text-muted-foreground border-b-2 border-transparent transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 data-[state=active]:text-primary data-[state=active]:font-semibold data-[state=active]:border-primary disabled:opacity-50 disabled:cursor-not-allowed data-[disabled]:opacity-50 data-[disabled]:cursor-not-allowed" tabindex="-1" data-orientation="horizontal" data-radix-collection-item="">Settings</button><button type="button" role="tab" aria-selected="false" aria-controls="radix-_rID_-content-versions" data-state="inactive" id="radix-_rID_-trigger-versions" class="inline-flex items-center gap-1.5 whitespace-nowrap px-0.5 py-2.5 text-sm font-medium text-muted-foreground border-b-2 border-transparent transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 data-[state=active]:text-primary data-[state=active]:font-semibold data-[state=active]:border-primary disabled:opacity-50 disabled:cursor-not-allowed data-[disabled]:opacity-50 data-[disabled]:cursor-not-allowed" tabindex="-1" data-orientation="horizontal" data-radix-collection-item="">Versions</button></div><div data-state="inactive" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-_rID_-trigger-preview" hidden="" id="radix-_rID_-content-preview" tabindex="0" class="mt-6 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"></div><div data-state="inactive" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-_rID_-trigger-questions" hidden="" id="radix-_rID_-content-questions" tabindex="0" class="mt-6 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"></div><div data-state="inactive" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-_rID_-trigger-scoring" hidden="" id="radix-_rID_-content-scoring" tabindex="0" class="mt-6 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"></div><div data-state="active" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-_rID_-trigger-settings" id="radix-_rID_-content-settings" tabindex="0" class="mt-6 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2" style="animation-duration: 0s;"><div data-testid="tab-panel-settings"><div class="space-y-6 max-w-2xl"><section class="wf-card" style="padding: 1.5rem;" data-testid="settings-audience-card"><h3 class="wf-card-title" style="margin-bottom: 1rem;">Who takes it &amp; who sees results</h3><div class="space-y-1.5"><span class="wf-label">Who can take it</span><p class="text-sm text-foreground"><strong>Invited only</strong> — each respondent gets a private magic link; answers are attributable.</p></div><div class="space-y-2" style="margin-top: 1.25rem;"><span class="wf-label">Who sees individual answers</span><div role="radiogroup" aria-label="Who sees individual answers" class="space-y-2"><label class="flex items-start gap-2 rounded border p-3 border-primary bg-primary/5 cursor-pointer"><input aria-label="Everyone" class="mt-0.5" type="radio" value="FULL_VISIBILITY" checked="" name="settings-aggregation"><span class="space-y-0.5"><span class="block text-sm font-semibold text-foreground">Everyone</span><span class="block text-[0.6875rem] text-muted-foreground">All viewers see each person's individual answers.</span></span></label><label class="flex items-start gap-2 rounded border p-3 border-border cursor-pointer"><input aria-label="CEO only" class="mt-0.5" type="radio" value="CEO_ONLY" name="settings-aggregation"><span class="space-y-0.5"><span class="block text-sm font-semibold text-foreground">CEO only</span><span class="block text-[0.6875rem] text-muted-foreground">Others see just their own answers; the CEO sees the team average (no individual rows).</span></span></label></div><p class="text-[0.6875rem] text-muted-foreground">Changes apply to every campaign launched from this assessment (including live ones).</p><div class="flex items-center gap-3"><button type="button" data-testid="settings-aggregation-save" disabled="" class="wf-btn wf-btn-primary disabled:opacity-50 disabled:cursor-not-allowed">Save</button></div></div></section><section class="wf-card" style="padding: 1.5rem;" data-testid="settings-default-report-style-card"><h3 class="wf-card-title" style="margin-bottom: 0.25rem;">Default report appearance</h3><p class="text-[0.6875rem] text-muted-foreground" style="margin-bottom: 1rem;">This default is copied into future campaigns only. Existing campaigns and reports do not change.</p><div aria-busy="false" class="min-w-0"><section aria-label="Report style selection" class="space-y-3"><fieldset class="space-y-2"><legend class="text-sm font-semibold text-foreground">Report style</legend><div class="grid gap-2 md:grid-cols-3"><label class="block cursor-pointer rounded-lg border border-border bg-background p-3 text-foreground shadow-sm transition focus-within:outline focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-ring has-[:checked]:border-primary has-[:disabled]:cursor-not-allowed has-[:disabled]:opacity-75"><input aria-checked="true" class="sr-only" type="radio" value="CLASSIC" checked="" name="_rID_"><span class="flex items-start justify-between gap-2"><span class="text-sm font-semibold leading-tight">Classic</span><span class="shrink-0 text-sm font-semibold text-primary"><span aria-hidden="true">✓</span><span class="sr-only">Selected</span></span></span><span class="mt-1.5 block text-xs leading-snug text-muted-foreground">A clear, familiar report presentation.</span><span class="mt-1.5 block text-xs text-muted-foreground">Paper format: A4</span></label><label class="block cursor-pointer rounded-lg border border-border bg-background p-3 text-foreground shadow-sm transition focus-within:outline focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-ring has-[:checked]:border-primary has-[:disabled]:cursor-not-allowed has-[:disabled]:opacity-75"><input aria-checked="false" class="sr-only" type="radio" value="EXECUTIVE_BOARDROOM" name="_rID_"><span class="flex items-start justify-between gap-2"><span class="text-sm font-semibold leading-tight">Executive Boardroom</span></span><span class="mt-1.5 block text-xs leading-snug text-muted-foreground">Editorial, restrained, and board-ready.</span><span class="mt-1.5 block text-xs text-muted-foreground">Paper format: US Letter</span></label><label class="block cursor-pointer rounded-lg border border-border bg-background p-3 text-foreground shadow-sm transition focus-within:outline focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-ring has-[:checked]:border-primary has-[:disabled]:cursor-not-allowed has-[:disabled]:opacity-75"><input aria-checked="false" class="sr-only" type="radio" value="MODERN_DASHBOARD" name="_rID_"><span class="flex items-start justify-between gap-2"><span class="text-sm font-semibold leading-tight">Modern Dashboard</span></span><span class="mt-1.5 block text-xs leading-snug text-muted-foreground">Compact, visual, and data-forward.</span><span class="mt-1.5 block text-xs text-muted-foreground">Paper format: US Letter</span></label></div></fieldset><div class="mt-3 flex flex-wrap gap-3 justify-end"><button type="button" aria-expanded="false" aria-controls="_rID_-preview" class="shrink-0 rounded-md border border-border px-3 py-1.5 text-sm font-medium text-foreground focus:outline focus:outline-2 focus:outline-offset-2 focus:outline-ring">Show preview</button></div></section></div><div class="mt-4 flex items-center gap-3"><button type="button" disabled="" class="wf-btn wf-btn-primary disabled:cursor-not-allowed disabled:opacity-50">Save default</button></div></section><section class="wf-card" style="padding: 1.5rem;" data-testid="settings-language-card"><div class="space-y-1.5"><label for="settings-language" class="wf-label">Language</label><select id="settings-language" class="wf-select"><option value="enUS">English (US)</option><option value="enGB">English (UK)</option><option value="esES">Spanish (Spain)</option><option value="frFR">French (France)</option></select><span class="block text-[0.6875rem] text-muted-foreground">Applies to this version's content</span></div></section><section class="wf-card" style="padding: 1.5rem;" data-testid="settings-invitation-card"><h3 class="wf-card-title" style="margin-bottom: 0.25rem;">Invitation email</h3><p class="text-[0.6875rem] text-muted-foreground" style="margin-bottom: 1rem;">Sent when a respondent is invited.</p><div class="space-y-1.5"><label for="settings-inv-subject" class="wf-label">Subject</label><input id="settings-inv-subject" class="wf-input" type="text" value=""></div><div class="space-y-1.5"><label for="settings-inv-message" class="wf-label">Message</label><textarea id="settings-inv-message" rows="6" class="wf-textarea font-mono text-xs"></textarea><div class="flex flex-wrap items-center gap-1 mt-2 p-2 rounded bg-muted/40 border border-border"><strong class="text-[0.6875rem] uppercase tracking-wide text-muted-foreground mr-1">Insert</strong><button type="button" class="text-[0.6875rem] font-mono px-1.5 py-0.5 rounded bg-background text-foreground border border-border hover:border-primary disabled:opacity-50 disabled:cursor-not-allowed">{{respondentFirstName}}</button><button type="button" class="text-[0.6875rem] font-mono px-1.5 py-0.5 rounded bg-background text-foreground border border-border hover:border-primary disabled:opacity-50 disabled:cursor-not-allowed">{{respondentLastName}}</button><button type="button" class="text-[0.6875rem] font-mono px-1.5 py-0.5 rounded bg-background text-foreground border border-border hover:border-primary disabled:opacity-50 disabled:cursor-not-allowed">{{campaignName}}</button><button type="button" class="text-[0.6875rem] font-mono px-1.5 py-0.5 rounded bg-background text-foreground border border-border hover:border-primary disabled:opacity-50 disabled:cursor-not-allowed">{{templateName}}</button><button type="button" class="text-[0.6875rem] font-mono px-1.5 py-0.5 rounded bg-background text-foreground border border-border hover:border-primary disabled:opacity-50 disabled:cursor-not-allowed">{{invitationUrl}}</button><button type="button" class="text-[0.6875rem] font-mono px-1.5 py-0.5 rounded bg-background text-foreground border border-border hover:border-primary disabled:opacity-50 disabled:cursor-not-allowed">{{closeAt}}</button><button type="button" class="text-[0.6875rem] font-mono px-1.5 py-0.5 rounded bg-background text-foreground border border-border hover:border-primary disabled:opacity-50 disabled:cursor-not-allowed">{{coachName}}</button><button type="button" class="text-[0.6875rem] font-mono px-1.5 py-0.5 rounded bg-background text-foreground border border-border hover:border-primary disabled:opacity-50 disabled:cursor-not-allowed">{{orgName}}</button></div></div><p class="text-[0.6875rem] text-muted-foreground" style="margin-top: 0.75rem;">Part of this version's content — saved with the draft, so it locks once the version is published.</p></section><section class="wf-card" style="padding: 1.5rem;" data-testid="settings-results-card"><h3 class="wf-card-title" style="margin-bottom: 0.25rem;">Results email</h3><p class="text-[0.6875rem] text-muted-foreground" style="margin-bottom: 1rem;">The email respondents receive with their results.</p><div class="space-y-1.5"><label for="settings-res-subject" class="wf-label">Subject</label><input id="settings-res-subject" placeholder="Your results are ready" class="wf-input" type="text" value=""></div><div class="space-y-1.5"><label for="settings-res-message" class="wf-label">Message</label><textarea id="settings-res-message" rows="5" placeholder="Hi {{respondentFirstName}},

Your results are ready to view." class="wf-textarea"></textarea><div class="flex flex-wrap items-center gap-1 mt-2 p-2 rounded bg-muted/40 border border-border"><strong class="text-[0.6875rem] uppercase tracking-wide text-muted-foreground mr-1">Insert</strong><button type="button" class="text-[0.6875rem] font-mono px-1.5 py-0.5 rounded bg-background text-foreground border border-border hover:border-primary disabled:opacity-50 disabled:cursor-not-allowed">{{respondentFirstName}}</button></div></div><p class="text-[0.6875rem] text-muted-foreground">Changes apply to every campaign launched from this assessment (including live ones).</p><div class="flex items-center gap-3"><button type="button" data-testid="settings-results-save" disabled="" class="wf-btn wf-btn-primary disabled:opacity-50 disabled:cursor-not-allowed">Save</button></div><div class="space-y-1" style="margin-top: 1rem;"><div class="flex items-center justify-between gap-2 p-3 rounded border border-border bg-muted/30"><span class="text-xs text-foreground">Allow coaches to enable results emails for respondents</span><div class="flex items-center gap-2"><span class="text-[0.6875rem] uppercase tracking-wide text-muted-foreground">Off</span><button type="button" role="switch" aria-checked="false" aria-label="Allow coaches to enable results emails for respondents" class="relative inline-flex h-5 w-9 items-center rounded-full border transition-colors disabled:opacity-50 disabled:cursor-not-allowed bg-muted border-border"><span class="inline-block h-3.5 w-3.5 rounded-full bg-background shadow transition-transform translate-x-0.5"></span></button></div></div><p class="text-[0.6875rem] text-muted-foreground">Coaches decide separately for each campaign.</p></div><div class="ml-4"><div class="space-y-1" style="margin-top: 1rem;"><div class="flex items-center justify-between gap-2 p-3 rounded border border-border bg-muted/30"><span class="text-xs text-foreground">Pre-select for new campaigns</span><div class="flex items-center gap-2"><span class="text-[0.6875rem] uppercase tracking-wide text-muted-foreground">Off</span><button type="button" role="switch" aria-checked="false" aria-label="Pre-select for new campaigns" class="relative inline-flex h-5 w-9 items-center rounded-full border transition-colors disabled:opacity-50 disabled:cursor-not-allowed bg-muted border-border"><span class="inline-block h-3.5 w-3.5 rounded-full bg-background shadow transition-transform translate-x-0.5"></span></button></div></div><p class="text-[0.6875rem] text-muted-foreground">New campaigns start with respondent results emails enabled.</p></div></div></section><section class="wf-card flex items-center justify-between gap-3" style="padding: 1rem 1.5rem;" data-testid="settings-access-groups-row"><span class="text-sm text-foreground">Manage who's allowed to take this assessment.</span><a class="text-sm font-medium text-primary hover:underline whitespace-nowrap" href="/admin/assessments/access-groups">Manage →</a></section><section class="wf-card" style="padding: 1.5rem;" data-testid="settings-advanced-card"><h3 class="wf-card-title" style="margin-bottom: 1rem;">Advanced</h3><div class="space-y-1.5"><label for="settings-alias" class="wf-label">Alias</label><input id="settings-alias" disabled="" readonly="" class="wf-input" type="text" value="scaling-up-full"><span class="block text-[0.6875rem] text-muted-foreground">Used internally to wire reports, benchmarks, and links. Changing it can silently break existing campaigns, so it's locked here.</span></div></section></div></div></div><div data-state="inactive" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-_rID_-trigger-versions" hidden="" id="radix-_rID_-content-versions" tabindex="0" class="mt-6 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"></div></div></div>"
`;

exports[`ED10 golden — forms-mode editor shell (ED10 flag OFF) ?tab=metadata: routes to the Metadata tab; full Metadata panel pinned 1`] = `
"<div class="space-y-6"><header class="wf-page-header-row"><div class="wf-page-title-block"><div class="wf-page-pill-row"><span data-testid="template-editor-version-pill" class="wf-version-pill-draft">v2 (draft)</span><span class="wf-pill wf-pill-access-invited">INVITED</span><span class="wf-pill wf-pill-agg-full">FULL_VISIBILITY</span><span style="font-style: italic;">(you are here)</span></div></div><div class="wf-page-action-row"><div class="relative"><button type="button" data-testid="safe-to-publish-badge" data-tone="blocker" class="wf-btn wf-btn-secondary wf-btn-sm">4 blockers</button></div><button type="button" class="wf-btn wf-btn-secondary wf-btn-sm" data-testid="template-editor-test-mode-btn">Test Mode</button><button type="button" disabled="" class="wf-btn wf-btn-secondary wf-btn-sm" data-testid="template-editor-save-draft-btn">Save Draft</button><button type="button" data-testid="template-editor-publish-btn" class="wf-btn wf-btn-primary wf-btn-sm">Publish v2 →</button></div></header><div dir="ltr" data-orientation="horizontal" aria-label="Template editor tabs"><div role="tablist" aria-orientation="horizontal" class="flex items-center gap-5 border-b border-border overflow-x-auto mb-6" tabindex="0" data-orientation="horizontal" style="outline: none;"><button type="button" role="tab" aria-selected="true" aria-controls="radix-_rID_-content-metadata" data-state="active" id="radix-_rID_-trigger-metadata" class="inline-flex items-center gap-1.5 whitespace-nowrap px-0.5 py-2.5 text-sm font-medium text-muted-foreground border-b-2 border-transparent transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 data-[state=active]:text-primary data-[state=active]:font-semibold data-[state=active]:border-primary disabled:opacity-50 disabled:cursor-not-allowed data-[disabled]:opacity-50 data-[disabled]:cursor-not-allowed" tabindex="-1" data-orientation="horizontal" data-radix-collection-item="">Metadata</button><button type="button" role="tab" aria-selected="false" aria-controls="radix-_rID_-content-questions" data-state="inactive" id="radix-_rID_-trigger-questions" class="inline-flex items-center gap-1.5 whitespace-nowrap px-0.5 py-2.5 text-sm font-medium text-muted-foreground border-b-2 border-transparent transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 data-[state=active]:text-primary data-[state=active]:font-semibold data-[state=active]:border-primary disabled:opacity-50 disabled:cursor-not-allowed data-[disabled]:opacity-50 data-[disabled]:cursor-not-allowed" tabindex="-1" data-orientation="horizontal" data-radix-collection-item="">Build</button><button type="button" role="tab" aria-selected="false" aria-controls="radix-_rID_-content-scoring" data-state="inactive" id="radix-_rID_-trigger-scoring" class="inline-flex items-center gap-1.5 whitespace-nowrap px-0.5 py-2.5 text-sm font-medium text-muted-foreground border-b-2 border-transparent transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 data-[state=active]:text-primary data-[state=active]:font-semibold data-[state=active]:border-primary disabled:opacity-50 disabled:cursor-not-allowed data-[disabled]:opacity-50 data-[disabled]:cursor-not-allowed" tabindex="-1" data-orientation="horizontal" data-radix-collection-item="">Scoring &amp; Tiers</button><a role="tab" aria-selected="false" data-testid="template-editor-access-link" class="inline-flex items-center gap-1.5 whitespace-nowrap px-0.5 py-2.5 text-sm font-medium text-muted-foreground border-b-2 border-transparent hover:text-foreground" href="/admin/assessments/access-groups">Access</a><button type="button" role="tab" aria-selected="false" aria-controls="radix-_rID_-content-versions" data-state="inactive" id="radix-_rID_-trigger-versions" class="inline-flex items-center gap-1.5 whitespace-nowrap px-0.5 py-2.5 text-sm font-medium text-muted-foreground border-b-2 border-transparent transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 data-[state=active]:text-primary data-[state=active]:font-semibold data-[state=active]:border-primary disabled:opacity-50 disabled:cursor-not-allowed data-[disabled]:opacity-50 data-[disabled]:cursor-not-allowed" tabindex="-1" data-orientation="horizontal" data-radix-collection-item="">Versions</button></div><div data-state="active" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-_rID_-trigger-metadata" id="radix-_rID_-content-metadata" tabindex="0" class="mt-6 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2" style="animation-duration: 0s;"><div data-testid="tab-panel-metadata"><div class="space-y-8"><div class="grid grid-cols-1 lg:grid-cols-[3fr_2fr] gap-6"><div class="space-y-6"><section class="wf-card" style="padding: 1.5rem;"><h3 class="wf-card-title" style="margin-bottom: 1rem;">Template Metadata</h3><div class="space-y-1.5"><label for="tpl-name" class="wf-label">Name</label><input id="tpl-name" class="wf-input" type="text" value="Alpha Template"></div><div class="space-y-1.5"><label for="tpl-alias" class="wf-label">Alias</label><input id="tpl-alias" class="wf-input" type="text" value="ALPHA"><span class="block text-[0.6875rem] text-muted-foreground">Used in URLs. Lowercase, no spaces.</span></div><div class="space-y-1.5"><label for="tpl-description" class="wf-label">Description</label><textarea id="tpl-description" rows="3" class="wf-textarea"></textarea></div><div class="space-y-1.5"><label for="tpl-language" class="wf-label">Language (this version)</label><select id="tpl-language" class="wf-select"><option value="en-US">en-US</option><option value="en-GB">en-GB</option><option value="es-ES">es-ES</option><option value="fr-FR">fr-FR</option></select></div><div class="space-y-1.5"><span class="block text-xs font-medium text-foreground">Access Mode</span><div role="radiogroup" aria-label="Access mode" class="grid grid-cols-1 md:grid-cols-2 gap-2"><label class="flex items-start gap-2 rounded border border-primary bg-primary/5 p-3 cursor-default" aria-disabled="true"><input readonly="" class="mt-0.5" aria-label="INVITED" type="radio" value="INVITED" checked="" name="access-mode"><span class="space-y-0.5"><span class="inline-flex items-center px-1.5 py-0.5 rounded text-[0.625rem] font-semibold bg-primary/10 text-primary">INVITED</span><span class="block text-[0.6875rem] text-muted-foreground">Magic-link invite per respondent, attributable.</span></span></label><label class="flex items-start gap-2 rounded border border-border bg-muted/40 p-3 opacity-60 cursor-not-allowed" title="v1 PUBLIC mode is hardcoded for Website Assessment templates only"><input disabled="" class="mt-0.5" aria-label="PUBLIC" type="radio" value="PUBLIC" name="access-mode"><span class="space-y-0.5"><span class="inline-flex items-center px-1.5 py-0.5 rounded text-[0.625rem] font-semibold bg-muted text-muted-foreground">PUBLIC</span><span class="block text-[0.6875rem] text-muted-foreground">v1 PUBLIC mode is hardcoded for Website Assessment; admin-authored PUBLIC templates ship v2.</span></span></label></div></div><div class="space-y-1.5"><span class="block text-xs font-medium text-foreground">Aggregation Mode</span><div role="radiogroup" aria-label="Aggregation mode" class="grid grid-cols-1 md:grid-cols-2 gap-2"><label class="flex items-start gap-2 rounded border p-3 border-primary bg-primary/5 cursor-pointer"><input class="mt-0.5" aria-label="FULL_VISIBILITY" type="radio" value="FULL_VISIBILITY" checked="" name="aggregation-mode"><span class="space-y-0.5"><span class="block text-xs font-semibold text-foreground">FULL_VISIBILITY</span><span class="block text-[0.6875rem] text-muted-foreground">All viewers see per-respondent rows.</span></span></label><label class="flex items-start gap-2 rounded border p-3 border-border cursor-pointer"><input class="mt-0.5" aria-label="CEO_ONLY" type="radio" value="CEO_ONLY" name="aggregation-mode"><span class="space-y-0.5"><span class="block text-xs font-semibold text-foreground">CEO_ONLY</span><span class="block text-[0.6875rem] text-muted-foreground">Non-CEO respondents see only their own row; CEO sees own + team aggregate (no per-respondent rows). v7.5 — Scaling Up Assessment uses this mode.</span></span></label></div></div></section><section class="wf-card" style="padding: 1.5rem;"><h3 class="wf-card-title" style="margin-bottom: 1rem;">Invitation Email</h3><div class="space-y-1.5"><label for="inv-subject" class="wf-label">Subject</label><input id="inv-subject" class="wf-input" type="text" value=""></div><div class="space-y-1.5"><label for="inv-body" class="wf-label">Body (Markdown)</label><textarea id="inv-body" rows="6" class="wf-textarea font-mono text-xs"></textarea><div class="flex flex-wrap items-center gap-1 mt-2 p-2 rounded bg-muted/40 border border-border"><strong class="text-[0.6875rem] uppercase tracking-wide text-muted-foreground mr-1">Available variables</strong><code class="text-[0.6875rem] font-mono px-1.5 py-0.5 rounded bg-background text-foreground border border-border">{{respondentFirstName}}</code><code class="text-[0.6875rem] font-mono px-1.5 py-0.5 rounded bg-background text-foreground border border-border">{{respondentLastName}}</code><code class="text-[0.6875rem] font-mono px-1.5 py-0.5 rounded bg-background text-foreground border border-border">{{campaignName}}</code><code class="text-[0.6875rem] font-mono px-1.5 py-0.5 rounded bg-background text-foreground border border-border">{{templateName}}</code><code class="text-[0.6875rem] font-mono px-1.5 py-0.5 rounded bg-background text-foreground border border-border">{{invitationUrl}}</code><code class="text-[0.6875rem] font-mono px-1.5 py-0.5 rounded bg-background text-foreground border border-border">{{closeAt}}</code><code class="text-[0.6875rem] font-mono px-1.5 py-0.5 rounded bg-background text-foreground border border-border">{{coachName}}</code><code class="text-[0.6875rem] font-mono px-1.5 py-0.5 rounded bg-background text-foreground border border-border">{{orgName}}</code></div></div></section><section class="wf-card" style="padding: 1.5rem;"><h3 class="wf-card-title" style="margin-bottom: 1rem;">Results Email</h3><p class="text-[0.6875rem] text-muted-foreground">The email respondents receive with their results.</p><div class="space-y-1.5"><label for="res-subject" class="wf-label">Subject</label><input id="res-subject" placeholder="Your results are ready" class="wf-input" type="text" value=""></div><div class="space-y-1.5"><label for="res-body" class="wf-label">Body (Markdown)</label><textarea id="res-body" rows="5" placeholder="Hi {{respondentFirstName}},

Your results are ready to view." class="wf-textarea"></textarea><div class="flex flex-wrap items-center gap-1 mt-2 p-2 rounded bg-muted/40 border border-border"><strong class="text-[0.6875rem] uppercase tracking-wide text-muted-foreground mr-1">Available variables (results email only)</strong><code class="text-[0.6875rem] font-mono px-1.5 py-0.5 rounded bg-background text-foreground border border-border">{{respondentFirstName}}</code></div></div><div class="space-y-1" style="margin-top: 1rem;"><div class="flex items-center justify-between gap-2 p-3 rounded border border-border bg-muted/30"><span class="text-xs text-foreground">Allow coaches to enable results emails for respondents</span><div class="flex items-center gap-2"><span class="text-[0.6875rem] uppercase tracking-wide text-muted-foreground">Off</span><button type="button" role="switch" aria-checked="false" aria-label="Allow coaches to enable results emails for respondents" class="relative inline-flex h-5 w-9 items-center rounded-full border transition-colors disabled:opacity-50 disabled:cursor-not-allowed bg-muted border-border"><span class="inline-block h-3.5 w-3.5 rounded-full bg-background shadow transition-transform translate-x-0.5"></span></button></div></div><p class="text-[0.6875rem] text-muted-foreground">Coaches decide separately for each campaign.</p></div><div class="ml-4 space-y-1"><div class="flex items-center justify-between gap-2 p-3 rounded border border-border bg-muted/30"><span class="text-xs text-foreground">Pre-select for new campaigns</span><div class="flex items-center gap-2"><span class="text-[0.6875rem] uppercase tracking-wide text-muted-foreground">Off</span><button type="button" role="switch" aria-checked="false" aria-label="Pre-select for new campaigns" class="relative inline-flex h-5 w-9 items-center rounded-full border transition-colors disabled:opacity-50 disabled:cursor-not-allowed bg-muted border-border"><span class="inline-block h-3.5 w-3.5 rounded-full bg-background shadow transition-transform translate-x-0.5"></span></button></div></div><p class="text-[0.6875rem] text-muted-foreground">New campaigns start with respondent results emails enabled.</p></div></section></div><div><section class="rounded-lg border border-border bg-card p-5 space-y-4" data-testid="sections-card" data-layout="compact"><div class="flex items-center justify-between gap-2"><h3 class="text-base font-semibold text-foreground">Sections (1)</h3><button type="button" class="inline-flex items-center gap-1 text-xs font-medium px-3 py-1.5 rounded border border-border text-foreground hover:bg-muted disabled:opacity-50 disabled:cursor-not-allowed">+ Add Section</button></div><ul class="divide-y divide-border rounded-md border border-border bg-background" aria-label="Sections list"><li style="opacity: 1;" class="flex flex-wrap items-center gap-2 px-3 py-2" data-testid="sections-row-UID0"><button type="button" aria-label="Drag to reorder S1" data-testid="sections-drag-handle-UID0" class="cursor-grab disabled:cursor-not-allowed text-muted-foreground hover:text-foreground" role="button" tabindex="0" aria-disabled="false" aria-roledescription="sortable" aria-describedby="DndDescribedBy-N"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-grip-vertical w-3.5 h-3.5" aria-hidden="true"><circle cx="9" cy="12" r="1"></circle><circle cx="9" cy="5" r="1"></circle><circle cx="9" cy="19" r="1"></circle><circle cx="15" cy="12" r="1"></circle><circle cx="15" cy="5" r="1"></circle><circle cx="15" cy="19" r="1"></circle></svg></button><span class="inline-flex items-center px-1.5 py-0.5 text-[0.625rem] font-mono font-semibold uppercase tracking-wide rounded bg-muted text-muted-foreground" aria-label="Section stable key S1">S1</span><input placeholder="Section name" aria-label="Section S1 name" class="flex-1 min-w-[12rem] bg-transparent px-1 py-0.5 text-sm text-foreground border border-transparent rounded focus:outline-none focus:border-border focus:bg-background disabled:opacity-60 disabled:cursor-not-allowed" type="text" value="Section One"><span class="text-[0.6875rem] text-muted-foreground whitespace-nowrap">1 question</span><div class="flex items-center gap-0.5"><button type="button" disabled="" aria-label="Move up S1" title="Move up" class="p-1 rounded hover:bg-muted disabled:opacity-30 disabled:cursor-not-allowed"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up w-3.5 h-3.5" aria-hidden="true"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg></button><button type="button" disabled="" aria-label="Move down S1" title="Move down" class="p-1 rounded hover:bg-muted disabled:opacity-30 disabled:cursor-not-allowed"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-down w-3.5 h-3.5" aria-hidden="true"><path d="M12 5v14"></path><path d="m19 12-7 7-7-7"></path></svg></button><button type="button" aria-label="Delete S1" title="Delete" class="p-1 rounded hover:bg-destructive/10 text-destructive disabled:opacity-30 disabled:cursor-not-allowed"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2 lucide-trash-2 w-3.5 h-3.5" aria-hidden="true"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button></div></li><div id="DndDescribedBy-N" style="display: none;">
    To pick up a draggable item, press the space bar.
    While dragging, use the arrow keys to move the item.
    Press space again to drop the item in its new position, or press escape to cancel.
  </div><div id="DndLiveRegion-N" style="position: fixed; top: 0px; left: 0px; width: 1px; height: 1px; margin: -1px; border: 0px; padding: 0px; overflow: hidden; clip-path: inset(100%); white-space: nowrap;" role="status" aria-live="assertive" aria-atomic="true"></div></ul><p class="text-[0.6875rem] italic text-muted-foreground">stableKey is auto-generated on first save; immutable across versions for longitudinal comparability.</p></section></div></div></div></div></div><div data-state="inactive" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-_rID_-trigger-questions" hidden="" id="radix-_rID_-content-questions" tabindex="0" class="mt-6 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"></div><div data-state="inactive" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-_rID_-trigger-scoring" hidden="" id="radix-_rID_-content-scoring" tabindex="0" class="mt-6 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"></div><div data-state="inactive" data-orientation="horizontal" role="tabpanel" aria-labelledby="radix-_rID_-trigger-versions" hidden="" id="radix-_rID_-content-versions" tabindex="0" class="mt-6 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"></div></div></div>"
