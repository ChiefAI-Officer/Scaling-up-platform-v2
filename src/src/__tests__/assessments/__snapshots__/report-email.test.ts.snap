exports[`buildReportEmailHtml — overall score freezes the exact legacy scored report email bytes: legacy-scored-report-email 1`] = `""<!DOCTYPE html>\\n<html lang=\\"en\\">\\n<head>\\n<meta charset=\\"utf-8\\" />\\n<meta name=\\"viewport\\" content=\\"width=device-width, initial-scale=1\\" />\\n<title>Scaling Up 4 Decisions Assessment</title>\\n</head>\\n<body style=\\"margin:0;padding:24px 12px;background:#eef0f4;font-family:'Helvetica Neue', Roboto, Arial, sans-serif;color:#2b2440;\\">\\n  <table role=\\"presentation\\" width=\\"100%\\" cellpadding=\\"0\\" cellspacing=\\"0\\" border=\\"0\\" style=\\"background:#eef0f4;\\">\\n    <tr>\\n      <td align=\\"center\\">\\n        <table role=\\"presentation\\" width=\\"640\\" cellpadding=\\"0\\" cellspacing=\\"0\\" border=\\"0\\" style=\\"max-width:640px;width:100%;background:#ffffff;border-radius:16px;overflow:hidden;\\">\\n          \\n  <tr>\\n    <td style=\\"height:6px;padding:0;font-size:0;line-height:0;background:#f7a600;\\">&nbsp;</td>\\n  </tr>\\n  <tr>\\n    <td style=\\"padding:0;font-size:0;line-height:0;\\">\\n      <table role=\\"presentation\\" width=\\"100%\\" cellpadding=\\"0\\" cellspacing=\\"0\\" border=\\"0\\">\\n        <tr>\\n          <td width=\\"25%\\" style=\\"height:4px;background:#f7a600;font-size:0;line-height:0;\\">&nbsp;</td>\\n          <td width=\\"25%\\" style=\\"height:4px;background:#008bd2;font-size:0;line-height:0;\\">&nbsp;</td>\\n          <td width=\\"25%\\" style=\\"height:4px;background:#946b36;font-size:0;line-height:0;\\">&nbsp;</td>\\n          <td width=\\"25%\\" style=\\"height:4px;background:#95c11f;font-size:0;line-height:0;\\">&nbsp;</td>\\n        </tr>\\n      </table>\\n    </td>\\n  </tr>\\n  <tr>\\n    <td style=\\"background:#522583;background-image:linear-gradient(135deg,#522583,#3d1a63);padding:28px 32px 26px;color:#ffffff;\\">\\n      <div style=\\"font-weight:800;letter-spacing:0.04em;font-size:14px;color:#ffffff;margin-bottom:14px;\\">SCALING UP</div>\\n      <div style=\\"font-size:21px;font-weight:800;color:#ffffff;line-height:1.2;margin-bottom:4px;\\">Scaling Up 4 Decisions Assessment</div>\\n      <div style=\\"font-size:13px;color:#ffffff;opacity:0.85;\\">Report for Monks Koala &middot; June 11, 2026</div>\\n      <div style=\\"font-size:13px;color:#ffffff;opacity:0.85;margin-top:4px;\\">Email: monks@example.com</div>\\n    </td>\\n  </tr>\\n          \\n          \\n  <tr>\\n    <td style=\\"padding:26px 32px;border-bottom:1px solid #ece8f2;\\">\\n      <table role=\\"presentation\\" width=\\"100%\\" cellpadding=\\"0\\" cellspacing=\\"0\\" border=\\"0\\">\\n        <tr>\\n          <td width=\\"120\\" valign=\\"middle\\" style=\\"padding:0 22px 0 0;\\">\\n            <table role=\\"presentation\\" cellpadding=\\"0\\" cellspacing=\\"0\\" border=\\"0\\" width=\\"110\\" style=\\"border:6px solid #f0e9fa;border-radius:55px;background:#ffffff;\\">\\n              <tr>\\n                <td align=\\"center\\" valign=\\"middle\\" style=\\"height:98px;width:98px;\\">\\n                  <div style=\\"font-size:30px;font-weight:800;color:#522583;line-height:1;\\">58</div>\\n                  <div style=\\"font-size:12px;color:#6b6480;line-height:1.4;\\">/ 100</div>\\n                </td>\\n              </tr>\\n            </table>\\n          </td>\\n          <td valign=\\"middle\\">\\n            <span style=\\"display:inline-block;background:#f0e9fa;color:#522583;font-weight:800;font-size:12px;letter-spacing:0.04em;text-transform:uppercase;padding:5px 12px;border-radius:999px;\\">Developing</span>\\n            <div style=\\"font-size:14px;color:#2b2440;margin-top:8px;line-height:1.5;\\">You have built a solid foundation.</div>\\n            <table role=\\"presentation\\" cellpadding=\\"0\\" cellspacing=\\"0\\" border=\\"0\\" style=\\"margin-top:14px;\\"><tr><td style=\\"padding:0 14px 0 0;vertical-align:top;\\">\\n       <div style=\\"font-size:18px;font-weight:800;color:#522583;line-height:1;\\">184</div>\\n       <div style=\\"font-size:11px;letter-spacing:0.04em;text-transform:uppercase;color:#6b6480;margin-top:2px;\\">Total points</div>\\n     </td><td style=\\"padding:0 14px;vertical-align:top;\\">\\n       <div style=\\"font-size:18px;font-weight:800;color:#522583;line-height:1;\\">5.75</div>\\n       <div style=\\"font-size:11px;letter-spacing:0.04em;text-transform:uppercase;color:#6b6480;margin-top:2px;\\">Avg / item</div>\\n     </td><td style=\\"padding:0 0 0 14px;vertical-align:top;\\">\\n       <div style=\\"font-size:18px;font-weight:800;color:#522583;line-height:1;\\">2</div>\\n       <div style=\\"font-size:11px;letter-spacing:0.04em;text-transform:uppercase;color:#6b6480;margin-top:2px;\\">Sections</div>\\n     </td></tr></table>\\n          </td>\\n        </tr>\\n      </table>\\n    </td>\\n  </tr>\\n          \\n    <tr>\\n      <td style=\\"padding:24px 32px 6px;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:#6b6480;font-weight:800;\\">How you scored, by decision</td>\\n    </tr>\\n    <tr>\\n      <td style=\\"padding:0 32px 6px;\\">\\n        <table role=\\"presentation\\" width=\\"100%\\" cellpadding=\\"0\\" cellspacing=\\"0\\" border=\\"0\\">\\n        <tr>\\n          <td style=\\"padding:6px 0;\\">\\n            <table role=\\"presentation\\" width=\\"100%\\" cellpadding=\\"0\\" cellspacing=\\"0\\" border=\\"0\\" style=\\"border:1px solid #ece8f2;border-left:5px solid #f7a600;border-radius:13px;\\">\\n              <tr>\\n                <td style=\\"padding:14px 15px;\\">\\n                  <table role=\\"presentation\\" width=\\"100%\\" cellpadding=\\"0\\" cellspacing=\\"0\\" border=\\"0\\">\\n                    <tr>\\n                      <td style=\\"font-weight:800;font-size:15px;color:#2b2440;\\">People</td>\\n                      <td align=\\"right\\" style=\\"font-size:22px;font-weight:800;color:#946b36;\\">4.5</td>\\n                    </tr>\\n                  </table>\\n                  <table role=\\"presentation\\" width=\\"100%\\" cellpadding=\\"0\\" cellspacing=\\"0\\" border=\\"0\\" style=\\"margin:10px 0 0;background:#eeeeee;border-radius:4px;\\">\\n                    <tr>\\n                      <td width=\\"45%\\" style=\\"height:7px;background:#f7a600;border-radius:4px;font-size:0;line-height:0;\\">&nbsp;</td>\\n                      <td style=\\"font-size:0;line-height:0;\\">&nbsp;</td>\\n                    </tr>\\n                  </table>\\n                </td>\\n              </tr>\\n            </table>\\n          </td>\\n        </tr>\\n        <tr>\\n          <td style=\\"padding:6px 0;\\">\\n            <table role=\\"presentation\\" width=\\"100%\\" cellpadding=\\"0\\" cellspacing=\\"0\\" border=\\"0\\" style=\\"border:1px solid #ece8f2;border-left:5px solid #95c11f;border-radius:13px;\\">\\n              <tr>\\n                <td style=\\"padding:14px 15px;\\">\\n                  <table role=\\"presentation\\" width=\\"100%\\" cellpadding=\\"0\\" cellspacing=\\"0\\" border=\\"0\\">\\n                    <tr>\\n                      <td style=\\"font-weight:800;font-size:15px;color:#2b2440;\\">Cash</td>\\n                      <td align=\\"right\\" style=\\"font-size:22px;font-weight:800;color:#6f9200;\\">8</td>\\n                    </tr>\\n                  </table>\\n                  <table role=\\"presentation\\" width=\\"100%\\" cellpadding=\\"0\\" cellspacing=\\"0\\" border=\\"0\\" style=\\"margin:10px 0 0;background:#eeeeee;border-radius:4px;\\">\\n                    <tr>\\n                      <td width=\\"80%\\" style=\\"height:7px;background:#95c11f;border-radius:4px;font-size:0;line-height:0;\\">&nbsp;</td>\\n                      <td style=\\"font-size:0;line-height:0;\\">&nbsp;</td>\\n                    </tr>\\n                  </table>\\n                </td>\\n              </tr>\\n            </table>\\n          </td>\\n        </tr></table>\\n      </td>\\n    </tr>\\n          \\n  <tr>\\n    <td style=\\"padding:24px 32px 6px;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:#6b6480;font-weight:800;\\">Score summary</td>\\n  </tr>\\n  <tr>\\n    <td style=\\"padding:8px 32px 6px;\\">\\n      <table role=\\"presentation\\" width=\\"100%\\" cellpadding=\\"0\\" cellspacing=\\"0\\" border=\\"0\\" style=\\"border-collapse:collapse;\\">\\n        <tr>\\n          <th style=\\"text-align:left;padding:9px 10px;border-bottom:1px solid #ece8f2;font-size:11px;letter-spacing:0.06em;text-transform:uppercase;color:#6b6480;\\">Decision</th>\\n          <th style=\\"text-align:right;padding:9px 10px;border-bottom:1px solid #ece8f2;font-size:11px;letter-spacing:0.06em;text-transform:uppercase;color:#6b6480;\\">Score</th>\\n          <th style=\\"text-align:right;padding:9px 10px;border-bottom:1px solid #ece8f2;font-size:11px;letter-spacing:0.06em;text-transform:uppercase;color:#6b6480;\\">Average</th>\\n        </tr>\\n        \\n      <tr>\\n        <td style=\\"text-align:left;padding:9px 10px;border-bottom:1px solid #ece8f2;font-size:13px;color:#2b2440;\\"><span style=\\"display:inline-block;width:9px;height:9px;border-radius:50%;background:#f7a600;margin-right:8px;\\">&nbsp;</span>People</td>\\n        <td style=\\"text-align:right;padding:9px 10px;border-bottom:1px solid #ece8f2;font-size:13px;color:#522583;font-weight:700;\\">36</td>\\n        <td style=\\"text-align:right;padding:9px 10px;border-bottom:1px solid #ece8f2;font-size:13px;color:#6b6480;\\">4.5</td>\\n      </tr>\\n      <tr>\\n        <td style=\\"text-align:left;padding:9px 10px;border-bottom:1px solid #ece8f2;font-size:13px;color:#2b2440;\\"><span style=\\"display:inline-block;width:9px;height:9px;border-radius:50%;background:#95c11f;margin-right:8px;\\">&nbsp;</span>Cash</td>\\n        <td style=\\"text-align:right;padding:9px 10px;border-bottom:1px solid #ece8f2;font-size:13px;color:#522583;font-weight:700;\\">64</td>\\n        <td style=\\"text-align:right;padding:9px 10px;border-bottom:1px solid #ece8f2;font-size:13px;color:#6b6480;\\">8</td>\\n      </tr>\\n        <tr>\\n          <td style=\\"text-align:left;padding:9px 10px;border-top:2px solid #2b2440;font-weight:800;color:#522583;font-size:13px;\\">Total</td>\\n          <td style=\\"text-align:right;padding:9px 10px;border-top:2px solid #2b2440;font-weight:800;color:#522583;font-size:13px;\\">184</td>\\n          <td style=\\"text-align:right;padding:9px 10px;border-top:2px solid #2b2440;font-weight:800;color:#522583;font-size:13px;\\">5.75</td>\\n        </tr>\\n      </table>\\n    </td>\\n  </tr>\\n          \\n      <tr>\\n        <td style=\\"padding:24px 32px 6px;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:#6b6480;font-weight:800;\\">Detailed breakdown</td>\\n      </tr>\\n      <tr>\\n        <td style=\\"padding:4px 32px 12px;\\">\\n          <table role=\\"presentation\\" width=\\"100%\\" cellpadding=\\"0\\" cellspacing=\\"0\\" border=\\"0\\">\\n            \\n          <tr>\\n            <td colspan=\\"2\\" style=\\"padding:14px 0 4px;font-weight:800;font-size:13px;color:#2b2440;\\"><span style=\\"display:inline-block;width:9px;height:9px;border-radius:50%;background:#f7a600;margin-right:8px;vertical-align:middle;\\">&nbsp;</span>People</td>\\n          </tr>\\n          \\n              <tr>\\n                <td style=\\"padding:8px 0;border-bottom:1px solid #ece8f2;font-size:13px;color:#3a3450;line-height:1.45;\\">Our employees are highly engaged.</td>\\n                <td align=\\"right\\" style=\\"padding:8px 0 8px 12px;border-bottom:1px solid #ece8f2;white-space:nowrap;vertical-align:top;\\">\\n                  <span style=\\"display:inline-block;min-width:30px;text-align:center;font-weight:800;font-size:13px;color:#522583;background:#f0e9fa;border-radius:7px;padding:3px 8px;font-variant-numeric:tabular-nums;\\">3 / 10</span>\\n                </td>\\n              </tr>\\n          <tr>\\n            <td colspan=\\"2\\" style=\\"padding:14px 0 4px;font-weight:800;font-size:13px;color:#2b2440;\\"><span style=\\"display:inline-block;width:9px;height:9px;border-radius:50%;background:#95c11f;margin-right:8px;vertical-align:middle;\\">&nbsp;</span>Cash</td>\\n          </tr>\\n          \\n              <tr>\\n                <td style=\\"padding:8px 0;border-bottom:1px solid #ece8f2;font-size:13px;color:#3a3450;line-height:1.45;\\">Our financial statements are accurate and timely.</td>\\n                <td align=\\"right\\" style=\\"padding:8px 0 8px 12px;border-bottom:1px solid #ece8f2;white-space:nowrap;vertical-align:top;\\">\\n                  <span style=\\"display:inline-block;min-width:30px;text-align:center;font-weight:800;font-size:13px;color:#522583;background:#f0e9fa;border-radius:7px;padding:3px 8px;font-variant-numeric:tabular-nums;\\">9 / 10</span>\\n                </td>\\n              </tr>\\n          </table>\\n        </td>\\n      </tr>\\n          \\n  <tr>\\n    <td style=\\"padding:22px 32px 0;\\">\\n      <table role=\\"presentation\\" width=\\"100%\\" cellpadding=\\"0\\" cellspacing=\\"0\\" border=\\"0\\" style=\\"background:#faf8fd;border:1px solid #ece8f2;border-radius:13px;\\">\\n        <tr>\\n          <td align=\\"center\\" style=\\"padding:20px;\\">\\n            <div style=\\"font-size:16px;font-weight:800;color:#2b2440;margin-bottom:6px;\\">Keep scaling, Monks.</div>\\n            <div style=\\"font-size:13px;color:#6b6480;line-height:1.5;margin-bottom:14px;\\">You&rsquo;ve completed your assessment. Turn these results into a 90-day plan with your Scaling Up Certified Coach.</div>\\n          </td>\\n        </tr>\\n      </table>\\n    </td>\\n  </tr>\\n  <tr>\\n    <td align=\\"center\\" style=\\"padding:18px 32px 0;\\">\\n      <a href=\\"https://scalingup.com\\" style=\\"display:inline-block;background:#ffffff;color:#522583;border:1px solid #522583;text-decoration:none;font-weight:700;padding:11px 22px;border-radius:11px;font-size:14px;margin:5px;\\">Learn More →</a>\\n      <a href=\\"https://scalingup.com/coaches\\" style=\\"display:inline-block;background:#522583;color:#ffffff;text-decoration:none;font-weight:700;padding:12px 22px;border-radius:11px;font-size:14px;margin:5px;\\">Talk to your Scaling Up Certified Coach →</a>\\n    </td>\\n  </tr>\\n  <tr>\\n    <td align=\\"center\\" style=\\"padding:18px 32px 26px;font-size:11px;color:#6b6480;\\">June 11, 2026 &middot; Generated by Scaling Up Platform</td>\\n  </tr>\\n        </table>\\n      </td>\\n    </tr>\\n  </table>\\n</body>\\n</html>""`;
